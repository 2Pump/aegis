# Copy to .env.local. Nothing here is secret; still, .env.local is git-ignored.
# Ink RPC (chain 57073). Default: public Gelato RPC.
VITE_INK_RPC=https://rpc-gel.inkonchain.com
# Nado is read directly from the browser (default). Nado's Cloudflare blocks servers/proxies,
# so only override these if you know what you're doing.
# VITE_NADO_GATEWAY=https://api.prod.nado.xyz/gateway/v1
# VITE_NADO_ARCHIVE=https://api.prod.nado.xyz/archive/v1
# Census snapshot (Step A). Default /census/census.json = what `pnpm census` writes locally.
# In production set this to the Vercel Blob URL printed by the GitHub Action (docs/CENSUS.md).
# VITE_CENSUS_URL=https://<store>.public.blob.vercel-storage.com/census/census.json
# Show the well before verification (with a PREVIEW banner). Dev builds always preview.
# VITE_WELL_PREVIEW=1
