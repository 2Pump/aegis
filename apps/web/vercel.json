{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @aegis/web build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1?__path=$1"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api/v1?__share=$1"
    },
    {
      "source": "/og/(.*)",
      "destination": "/api/v1?__og=$1"
    },
    {
      "source": "/((?!assets/|api/|robots.txt|sitemap.xml|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/v1.js": {
      "maxDuration": 20,
      "memory": 1024,
      "includeFiles": "api-assets/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(s|og)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/billing/remind",
      "schedule": "7 15 * * *"
    }
  ]
}
