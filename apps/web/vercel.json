{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @aegis/web build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1?__path=$1"
    },
    {
      "source": "/((?!assets/|api/|robots.txt|sitemap.xml|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/v1.js": {
      "maxDuration": 20,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
